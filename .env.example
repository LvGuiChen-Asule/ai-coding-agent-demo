# 选择 LLM Provider：mock（离线演示）/ openai / qwen
LLM_PROVIDER=mock

# ---------- OpenAI ----------
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ---------- 通义千问（DashScope 兼容模式） ----------
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ---------- 运行参数 ----------
# 默认输出目录
WORKSPACE_ROOT=./demo_output
# 测试失败后最大自动修复轮数
MAX_FIX_ITERATIONS=3
# FastAPI 服务端口
SERVER_PORT=8000

